#!/usr/bin/env bash
# KDE session starter, run by autostart through dbus-launch.
#
# ksmserver starts before krusader so both share the session bus. It registers
# as org.kde.ksmserver and emits saveYourself on logout, which makes
# KMainWindow::saveAutoSaveSettings() persist window geometry and panel state to
# krusaderrc (bug #1); the shared bus also routes Kate's close events (bug #2).
# Without ksmserver (an image built without plasma-workspace) krusader simply
# starts on its own.
#
# krusader runs in the background with the shutdown signal trapped, so that
# `docker stop` asks it to quit before killing it (see _save_and_quit).

if command -v ksmserver >/dev/null 2>&1; then
    echo "[krusader-session] starting ksmserver for D-Bus session management" >&2
    ksmserver --no-lockscreen 2>/dev/null &
    # Give ksmserver time to register on the session bus before krusader starts.
    sleep 0.5
fi

# Open With (KOpenWithDialog/KApplicationTrader) is filled from the binary
# KSycoca cache, not from the .desktop files (#22). Building it here, in the
# live session as the uid and $HOME this krusader runs under, puts it in the
# ${XDG_CACHE_HOME:-$HOME/.cache} the process reads. That matters under PUID=0,
# where the session runs as literal root (LSIO cannot remap abc onto uid 0) and
# $HOME/.cache is not the abc-owned /config/.cache that init-krusader filled.
# KF6 reads only ksycoca6_*, so a KF5 ksycoca5_* leftover is removed first.
_kr_cache="${XDG_CACHE_HOME:-$HOME/.cache}"
rm -f "${_kr_cache}"/ksycoca5_* 2>/dev/null || true
# KDE's icon pixmap cache survives image updates in /config and would keep
# serving the old MediaButton icon; KIconLoader rebuilds it lazily.
rm -f "${_kr_cache}"/icon-cache.kcache 2>/dev/null || true
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    # --noincremental: a timestamp-based incremental rebuild can skip newly
    # deployed mimeapps.list associations on the persistent /config volume.
    kbuildsycoca6 --noincremental >/dev/null 2>&1 \
        && echo "[krusader-session] kbuildsycoca6: KSycoca cache built in ${_kr_cache}" >&2 \
        || echo "[krusader-session] WARNING: kbuildsycoca6 failed, 'Open With...' may be empty (#22)" >&2
else
    echo "[krusader-session] WARNING: kbuildsycoca6 not found, 'Open With...' will be empty (#22)" >&2
fi

KR_PID=""

_save_and_quit() {
    echo "[krusader-session] shutdown, quitting krusader cleanly so it saves" >&2
    # Ask krusader to quit itself first: quitting through the application runs
    # aboutToQuit and "Save settings on exit", a signal does not. The call is
    # addressed by D-Bus service name rather than by PID, so it also reaches
    # the instance when KR_PID is stale or unset (a signal can arrive between
    # starting krusader and recording its PID).
    #
    # In the built image the call does not succeed yet: Krusader registers no
    # name on the session bus (qdbus6 lists only org.kde.ksmserver), so it
    # returns "Service 'org.kde.krusader' does not exist" and the SIGTERM below
    # ends krusader. The attempt costs one failed lookup and starts working the
    # day krusader registers a name. Settings survive a container stop because
    # Krusader 2.9.0 writes its state as it goes, not because of this call.
    qdbus6 org.kde.krusader /MainApplication quit 2>/dev/null \
        || { [ -n "${KR_PID}" ] && kill -0 "${KR_PID}" 2>/dev/null && kill -TERM "${KR_PID}" 2>/dev/null; }
    [ -n "${KR_PID}" ] && wait "${KR_PID}" 2>/dev/null
    exit 0
}
trap _save_and_quit TERM INT HUP

# Krusader is the container's only window. When the user quits it (File > Quit,
# the window's close button, Ctrl+Q), openbox keeps running on an empty desktop
# and the WebUI stays black until the container restarts, so krusader is
# restarted here instead.
#
# Two guards stop a spin. Both count only runs shorter than KR_MIN_RUNTIME
# seconds, and both reset after any longer run:
#
#   KR_MAX_FAILS   non-zero exits in a row: krusader cannot start at all
#                  (broken config, no X, a missing library). Kept low, since a
#                  failing start is never the user's doing.
#   KR_MAX_QUICK   instant exits of any kind in a row, clean ones included.
#                  Catches a krusader that keeps exiting 0 at once (a second
#                  instance handing over to a unique-instance owner that is
#                  already gone, say), which the failure counter never sees.
#                  Kept high, so a user who quits a few times in quick
#                  succession keeps the session.
#
# These messages go to the session's stderr, which startwm.sh sends to
# /dev/null so nothing trails the READY banner in `docker logs`. They are for
# debugging with that redirect removed.
KR_MIN_RUNTIME=5
KR_MAX_FAILS=5
KR_MAX_QUICK=20
_fails=0
_quick=0

while : ; do
    _started=${SECONDS}
    krusader "$@" &
    KR_PID=$!
    wait "${KR_PID}"
    _rc=$?
    _ran=$((SECONDS - _started))

    if [ "${_ran}" -lt "${KR_MIN_RUNTIME}" ]; then
        _quick=$((_quick + 1))
        [ "${_rc}" -ne 0 ] && _fails=$((_fails + 1))

        if [ "${_fails}" -ge "${KR_MAX_FAILS}" ]; then
            echo "[krusader-session] krusader failed ${_fails} times in a row within ${KR_MIN_RUNTIME}s each (last exit code ${_rc}), giving up instead of looping. Fix the cause and restart the container." >&2
            exit "${_rc}"
        fi
        if [ "${_quick}" -ge "${KR_MAX_QUICK}" ]; then
            echo "[krusader-session] krusader exited within ${KR_MIN_RUNTIME}s ${_quick} times in a row (last exit code ${_rc}), giving up instead of looping. Fix the cause and restart the container." >&2
            exit 1
        fi
    else
        _fails=0
        _quick=0
    fi

    echo "[krusader-session] krusader exited (code ${_rc}, ran ${_ran}s), restarting it so the WebUI does not stay black" >&2
    sleep 1
done
