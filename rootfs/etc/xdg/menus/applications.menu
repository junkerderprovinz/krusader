<?xml version="1.0"?>
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<!-- Minimal XDG application menu (#22). kbuildsycoca6 indexes applications
     through the XDG menu spec: without an applications.menu it logs
     '"applications.menu" not found' and builds a KSycoca without the
     application services, so KApplicationTrader resolves no app, "Open With"
     shows no suggestions and a double-click falls back to the chooser even
     with a correct mimeapps.list. plasma-workspace ships only
     plasma-applications.menu, which a full Plasma session selects through
     XDG_MENU_PREFIX=plasma-. Under openbox a plain include-everything menu
     gives the service index, and menu categories are not needed. -->
<Menu>
  <Name>Applications</Name>
  <DefaultAppDirs/>
  <DefaultDirectoryDirs/>
  <Include>
    <All/>
  </Include>
</Menu>
