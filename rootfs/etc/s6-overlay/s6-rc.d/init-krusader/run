#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Theme and config bootstrap for Krusader. Runs after init-selkies-config, which
# copies /defaults/autostart into /config/.config/openbox/autostart and restores
# /etc/xdg/openbox/rc.xml from a .bak on every start before applying its
# NO_DECOR/NO_FULL seds. The full rc.xml override in 2d still wins because this
# runs afterwards, but NO_DECOR/NO_FULL have no effect on it.
#
# KDE apps colour themselves through KColorScheme, which works only when
#   (a) the "kde" Qt platform theme plugin is loaded (libkdeplatformtheme.so
#       from plasma-integration),
#   (b) the colour scheme file is in KDE format on the standard search path
#       (~/.local/share/color-schemes/ or /usr/share/color-schemes/),
#   (c) kdeglobals names the ColorScheme, and
#   (d) XDG_CURRENT_DESKTOP=KDE is set, otherwise the plugin stays inactive.
# qt5ct cannot read KDE .colors files (its format is a single
# active_colors=#aarrggbb,... line) and returns a blank white palette for them.
set -e

log() { echo "[init-krusader] $*"; }

# Everything that differs between the two themes is derived here, so the rest
# of the script stays consistent. dark is our Dark Mode (Carbon greyscale,
# DarkMode.colors); light is KDE Breeze Light, shipped by breeze and
# plasma-workspace at /usr/share/color-schemes/BreezeLight.colors. The palette
# merge below has to follow this choice, or light mode stays dark. The accepted
# spellings match the READY banner's, so init and banner agree on the theme.
THEME_LC="$(echo "${KRUSADER_THEME:-dark}" | tr '[:upper:]' '[:lower:]')"
case "${THEME_LC}" in
    light|breeze|breezelight)
        THEME_SCHEME="BreezeLight"; THEME_NAME="Breeze Light"
        THEME_LNF="org.kde.breeze.desktop"
        THEME_COLORS="/usr/share/color-schemes/BreezeLight.colors"
        THEME_GTK="Breeze"; THEME_ICONS="breeze"; THEME_KATE="Breeze Light"
        ;;
    *)
        THEME_SCHEME="DarkMode"; THEME_NAME="Dark Mode"
        THEME_LNF="org.kde.breezedark.desktop"
        THEME_COLORS="/defaults/color-schemes/DarkMode.colors"
        THEME_GTK="Breeze-Dark"; THEME_ICONS="breeze-dark"; THEME_KATE="Dark Mode"
        ;;
esac

# 1) Environment for every s6 service: each file in
# /run/s6/container_environment is one variable.
mkdir -p /run/s6/container_environment

set_env() {
    printf "%s" "$2" > "/run/s6/container_environment/$1"
}

# QT_QPA_PLATFORMTHEME=kde with XDG_CURRENT_DESKTOP=KDE loads the plugin from
# plasma-integration, which reads kdeglobals and knows the KDE .colors format.
set_env QT_QPA_PLATFORMTHEME      "kde"
set_env XDG_CURRENT_DESKTOP       "KDE"
set_env XDG_SESSION_DESKTOP       "KDE"
set_env DESKTOP_SESSION           "plasma"

# Breeze also for Qt apps that do not load the KDE plugin.
set_env QT_STYLE_OVERRIDE         "Breeze"
set_env QT_AUTO_SCREEN_SCALE_FACTOR "1"

# The plugin finds the scheme through kdeglobals; this is only a hint.
set_env KDE_COLOR_SCHEME_PATH     "/usr/share/color-schemes/${THEME_SCHEME}.colors"

# For the GTK dialogs Krusader opens, during file operations for example.
set_env GTK_THEME                 "${THEME_GTK}"
set_env XCURSOR_THEME             "breeze_cursors"
set_env ICON_THEME                "${THEME_ICONS}"

log "ENV in /run/s6/container_environment gesetzt (KDE-Plugin-Mode)"

# 2) Theme and config files
DEFAULTS="/defaults"
CONFIG_HOME="/config/.config"
LOCAL_SHARE="/config/.local/share"
USER_COLOR_SCHEMES="${LOCAL_SHARE}/color-schemes"
SYSTEM_COLOR_SCHEMES="/usr/share/color-schemes"
KDEDEFAULTS="${CONFIG_HOME}/kdedefaults"

mkdir -p "${CONFIG_HOME}/qt5ct" \
         "${CONFIG_HOME}/qt6ct" \
         "${CONFIG_HOME}/openbox" \
         "${KDEDEFAULTS}" \
         "${USER_COLOR_SCHEMES}" \
         "${LOCAL_SHARE}/krusader" \
         "${SYSTEM_COLOR_SCHEMES}"

LOCK="/config/.krusader-firstrun.done"

# 2a) Files the user may edit are seeded on the first run only.
if [[ ! -f "${LOCK}" ]]; then
    log "First run: seeding user-editable defaults"
    [[ ! -e "${CONFIG_HOME}/krusaderrc"      ]] && cp -a "${DEFAULTS}/krusaderrc"      "${CONFIG_HOME}/krusaderrc"
    [[ ! -e "${CONFIG_HOME}/katerc"          ]] && cp -a "${DEFAULTS}/katerc"          "${CONFIG_HOME}/katerc"
    [[ ! -e "${LOCAL_SHARE}/krusader/useractions.xml" ]] && cp -a "${DEFAULTS}/useractions.xml.template" "${LOCAL_SHARE}/krusader/useractions.xml"
    touch "${LOCK}"
fi

# Krusader can write its own krusaderrc on its very first start, before the
# first-run copy lands, and that file lacks the keys below. ensure_ini_key adds
# a missing key and leaves an existing value alone.
ensure_ini_key() {
    local file="$1" section="$2" key="$3" value="$4"
    [[ -f "$file" ]] || return 0
    if ! grep -qE "^\[${section}\]" "$file"; then
        printf '\n[%s]\n%s=%s\n' "$section" "$key" "$value" >> "$file"
        return 0
    fi
    if awk -v s="[${section}]" -v k="$key" '
        $0==s {in_s=1; next}
        /^\[/ && in_s {in_s=0}
        in_s && $0 ~ "^"k"=" {found=1; exit}
        END {exit !found}
    ' "$file"; then
        return 0
    fi
    sed -i "/^\[${section}\]/a ${key}=${value}" "$file"
}

if [[ -f "${CONFIG_HOME}/krusaderrc" ]]; then
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Startup" "Remember Position"   "true"
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Startup" "User Save Settings"  "true"
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Startup" "Show splashscreen"   "false"
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Startup" "Show statusbar"      "true"
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Startup" "Show Cmd Line"       "true"
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Startup" "Show Function Keys"  "true"
    # openbox has no system tray, so "Show and close to tray" would hide the
    # window with no way to get it back (#26).
    ensure_ini_key "${CONFIG_HOME}/krusaderrc" "Look&Feel" "Minimize To Tray"   "false"
    log "krusaderrc: Startup-Keys idempotent gesichert"
    # Status bar and command line start hidden. Krusader honours Show statusbar
    # and Show Cmd Line only while User Save Settings is on, so that stays on
    # and the two bars are forced off on every start.
    sed -i 's|^User Save Settings=.*|User Save Settings=true|'  "${CONFIG_HOME}/krusaderrc"
    sed -i 's|^Show statusbar=.*|Show statusbar=false|'         "${CONFIG_HOME}/krusaderrc"
    sed -i 's|^Show Cmd Line=.*|Show Cmd Line=false|'           "${CONFIG_HOME}/krusaderrc"
    # Tray mode is forced off even when a user turned it on (#26).
    sed -i 's|^Minimize To Tray=.*|Minimize To Tray=false|'     "${CONFIG_HOME}/krusaderrc"
    log "krusaderrc: statusbar + command line hidden, tray disabled (issue #26)"
fi

# 2b) Theme files are redeployed on every start.
log "Theme-Infrastruktur (re)deploy"
# An image built from a Windows checkout can carry CRLF here; KConfig then reads
# "[Icons]\r" as a different group and the icon theme switch fails silently.
tr -d '\r' < "${DEFAULTS}/kdeglobals" > "${CONFIG_HOME}/kdeglobals"
tr -d '\r' < "${DEFAULTS}/kdeglobals" > "${KDEDEFAULTS}/kdeglobals"

# KColorScheme builds the Qt palette and the view focus and hover decoration
# (the file panel frame) from kdeglobals' [Colors:*] groups; a separate .colors
# file is not read for the palette, so the selected scheme is merged in.
if [[ -f "${THEME_COLORS}" ]]; then
    _colors="$(awk '/^\[General\]/{exit} /^\[Color/{p=1} p{print}' "${THEME_COLORS}")"
    for _kg in "${CONFIG_HOME}/kdeglobals" "${KDEDEFAULTS}/kdeglobals"; do
        printf '\n%s\n' "${_colors}" >> "${_kg}"
    done
    log "kdeglobals: [Colors:*] merged from ${THEME_COLORS##*/} (palette source)"
else
    log "WARNING: palette source ${THEME_COLORS} not found, colours may be wrong"
fi

# The KDE plugin looks in ~/.local/share/color-schemes/ first, then in
# /usr/share/color-schemes/; both get the scheme.
if [[ -f "${DEFAULTS}/color-schemes/DarkMode.colors" ]]; then
    cp -af "${DEFAULTS}/color-schemes/DarkMode.colors" "${USER_COLOR_SCHEMES}/DarkMode.colors"
    cp -af "${DEFAULTS}/color-schemes/DarkMode.colors" "${SYSTEM_COLOR_SCHEMES}/DarkMode.colors" 2>/dev/null || true
fi

# qt5ct/qt6ct only matter when the KDE plugin fails to load, in a build without
# plasma-integration for example.
if [[ -f "${DEFAULTS}/qt5ct.conf" ]]; then
    cp -af "${DEFAULTS}/qt5ct.conf" "${CONFIG_HOME}/qt5ct/qt5ct.conf"
    cp -af "${DEFAULTS}/qt5ct.conf" "${CONFIG_HOME}/qt6ct/qt6ct.conf"
fi
# qt5ct has its own colour scheme format.
mkdir -p "${CONFIG_HOME}/qt5ct/colors" "${CONFIG_HOME}/qt6ct/colors"
if [[ -f "${DEFAULTS}/qt5ct-colors/DarkMode.conf" ]]; then
    cp -af "${DEFAULTS}/qt5ct-colors/DarkMode.conf" "${CONFIG_HOME}/qt5ct/colors/DarkMode.conf"
    cp -af "${DEFAULTS}/qt5ct-colors/DarkMode.conf" "${CONFIG_HOME}/qt6ct/colors/DarkMode.conf"
fi

# Kate editor "Dark Mode" syntax theme (Carbon greyscale). KTextEditor reads
# custom themes from $XDG_DATA_HOME/org.kde.syntax-highlighting/themes/; katerc
# selects it via "Color Theme=Dark Mode".
if [[ -f "${DEFAULTS}/syntax-themes/DarkMode.theme" ]]; then
    mkdir -p "${LOCAL_SHARE}/org.kde.syntax-highlighting/themes"
    cp -af "${DEFAULTS}/syntax-themes/DarkMode.theme" "${LOCAL_SHARE}/org.kde.syntax-highlighting/themes/DarkMode.theme"
    log "Kate Dark Mode syntax theme deployed"
fi

# 2c) The openbox autostart is replaced on every start.
cp -af "${DEFAULTS}/autostart" "${CONFIG_HOME}/openbox/autostart"
chmod 0755 "${CONFIG_HOME}/openbox/autostart"

# 2d) The base patches openbox's rc.xml to open every window maximised, dialogs
# such as "Delete file?" included. Dialogs should keep their natural or last
# used size.
if [[ -f "${DEFAULTS}/openbox-rc.xml" ]]; then
    install -m 0644 "${DEFAULTS}/openbox-rc.xml" /etc/xdg/openbox/rc.xml
    log "openbox rc.xml overridden (no force-maximize for dialogs)"
fi

# 3) Language and theme
/usr/local/bin/krusader-language.sh "${KRUSADER_LANG:-de}" || log "language hook failed"

# krusader-language.sh writes LANG/LANGUAGE/LC_ALL to a profile snippet. Reading
# them back into the s6 environment lets every process (krusader, kate, KIO
# workers) inherit them over the image's ENV defaults.
if [[ -f /config/.profile.d/krusader-lang.sh ]]; then
    # The snippet quotes its values for dash. Strip the quotes, or
    # LANG='"de_DE.UTF-8"' lands in the s6 env and every service warns
    # 'cannot change locale ("de_DE.UTF-8")'.
    _unq() { local v="$1"; v="${v#\"}"; v="${v%\"}"; printf '%s' "$v"; }
    _L=$(_unq "$(grep  '^export LANG='     /config/.profile.d/krusader-lang.sh | head -1 | cut -d= -f2-)")
    _A=$(_unq "$(grep  '^export LC_ALL='   /config/.profile.d/krusader-lang.sh | head -1 | cut -d= -f2-)")
    _C=$(_unq "$(grep  '^export LANGUAGE=' /config/.profile.d/krusader-lang.sh | head -1 | cut -d= -f2-)")
    [[ -n "$_L" ]] && set_env LANG     "$_L"
    [[ -n "$_A" ]] && set_env LC_ALL   "$_A"
    [[ -n "$_C" ]] && set_env LANGUAGE "$_C"
    log "Locale -> s6 env: LANG=${_L:-unchanged}"
fi

# Apply the selected scheme name, look-and-feel and Kate theme. The matching
# [Colors:*] palette was already merged into kdeglobals above.
sed -i "s/^ColorScheme=.*/ColorScheme=${THEME_SCHEME}/"             "${CONFIG_HOME}/kdeglobals" || true
sed -i "s/^Name=.*/Name=${THEME_NAME}/"                            "${CONFIG_HOME}/kdeglobals" || true
sed -i "s/^LookAndFeelPackage=.*/LookAndFeelPackage=${THEME_LNF}/"  "${CONFIG_HOME}/kdeglobals" || true
# The kdedefaults copy too, or under light it pairs a light palette with the
# dark scheme name.
sed -i "s/^ColorScheme=.*/ColorScheme=${THEME_SCHEME}/"             "${KDEDEFAULTS}/kdeglobals" || true
sed -i "s/^Name=.*/Name=${THEME_NAME}/"                            "${KDEDEFAULTS}/kdeglobals" || true
sed -i "s/^LookAndFeelPackage=.*/LookAndFeelPackage=${THEME_LNF}/"  "${KDEDEFAULTS}/kdeglobals" || true
# The shipped kdeglobals sets the breeze-dark icon theme; without this every
# icon, in the file list and the status bar, keeps its dark tint under
# KRUSADER_THEME=light.
sed -i "s/^Theme=.*/Theme=${THEME_ICONS}/"                          "${CONFIG_HOME}/kdeglobals" || true
sed -i "s/^Theme=.*/Theme=${THEME_ICONS}/"                          "${KDEDEFAULTS}/kdeglobals" || true
sed -i "s/^ColorScheme=.*/ColorScheme=${THEME_SCHEME}/"             "${CONFIG_HOME}/krusaderrc"  || true
if [[ -f "${CONFIG_HOME}/katerc" ]]; then
    sed -i "s/^Color Theme=.*/Color Theme=${THEME_KATE}/"          "${CONFIG_HOME}/katerc" || true
    sed -i "s/^Schema=.*/Schema=${THEME_KATE}/"                    "${CONFIG_HOME}/katerc" || true
fi

# The MediaButton icon follows the configured status bar colour (#22). The
# button sits on Krusader's status bar, whose colours the user sets in the
# Konfigurator (krusaderrc [Colors] "Statusbar Foreground/Background Active"),
# but KIconLoader tints currentColor icons from the global palette, which knows
# nothing about that bar, so on a light bar the icon stayed light. The
# configured foreground is the colour of the bar's text and therefore readable;
# it is baked into the icon from the pristine build copies on every start, so a
# colour change applies on the next container start.
#
# rgb_to_hex turns a decimal "R,G,B" into "#rrggbb" and prints nothing for
# anything else (wrong component count, non-digits, values over 255; leading
# zeros read as decimal). A hand-edited krusaderrc would otherwise stop printf
# under set -e or bake a broken colour.
rgb_to_hex() {
    case ",$1," in *[!0-9,]*|*,,*) echo ""; return ;; esac
    case "$1" in *,*,*,*) echo ""; return ;; *,*,*) : ;; *) echo ""; return ;; esac
    local _r _g _b _rest
    _r="${1%%,*}"; _rest="${1#*,}"; _g="${_rest%%,*}"; _b="${_rest##*,}"
    _r=$((10#${_r})); _g=$((10#${_g})); _b=$((10#${_b}))
    if [ "${_r}" -gt 255 ] || [ "${_g}" -gt 255 ] || [ "${_b}" -gt 255 ]; then echo ""; return; fi
    printf '#%02x%02x%02x' "${_r}" "${_g}" "${_b}"
}

# The fixed fill and the renamed stylesheet id keep KIconLoader from tinting over
# it from the palette; lowercase "currentcolor" is valid CSS too.
bake_svg() { # $1=src $2=dst $3=hex
    sed -e "s/currentColor/$3/g" -e "s/currentcolor/$3/g" \
        -e 's/id="current-color-scheme"/id="frozen-color-scheme"/' \
        "$1" > "$2"
}

MB_STORE="/usr/local/share/krusader-mediabutton"
if [[ -d "${MB_STORE}" ]]; then
    FG_RGB="$(grep -m1 '^Statusbar Foreground Active=' "${CONFIG_HOME}/krusaderrc" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')"
    FG_HEX="$(rgb_to_hex "${FG_RGB}")"
    mb_n=0
    for mb_src in "${MB_STORE}"/*/*.svg; do
        [[ -e "${mb_src}" ]] || continue
        mb_theme="$(basename "$(dirname "${mb_src}")")"
        mb_sz="$(basename "${mb_src}" .svg)"
        mb_dst="/usr/share/icons/${mb_theme}/apps/${mb_sz}/system-file-manager.svg"
        [[ -d "$(dirname "${mb_dst}")" ]] || continue
        if [[ -n "${FG_HEX}" ]]; then
            bake_svg "${mb_src}" "${mb_dst}" "${FG_HEX}"
        else
            # no valid colour configured: restore the stock icon and let the
            # palette tint it for the theme
            cp -f "${mb_src}" "${mb_dst}"
        fi
        mb_n=$((mb_n + 1))
    done
    if [[ -n "${FG_HEX}" ]]; then
        log "MediaButton-Icon auf Statusbar-Foreground ${FG_HEX} getoent (${mb_n} Dateien)"
    else
        log "MediaButton-Icon: keine Statusbar-Farbe gesetzt, Stock-Icon restauriert (${mb_n})"
    fi
fi

# Folder icons in the file list follow the configured panel colour the same
# way: "Directory Foreground" from krusaderrc [Colors], else "Foreground", is
# baked into places/<sz>/folder.svg, where the list's inode-directory symlinks
# point. Without a colour the pristine copies are restored. Keys are read from
# [Colors] only, and an empty value (what the Konfigurator writes for
# "Default") counts as unset.
PF_STORE="/usr/local/share/krusader-panelfolder"
if [[ -d "${PF_STORE}" ]]; then
    # The patched source build tints the list icons itself, in each row's text
    # colour (normal, current, selected). A baked icon would defeat that, since
    # KIconLoader cannot recolour a frozen scheme, so it always gets the stock
    # icons.
    if [[ -f /usr/share/krusader/.icontint ]]; then
        pf_n=0
        for pf_src in "${PF_STORE}"/*/*.svg; do
            [[ -e "${pf_src}" ]] || continue
            pf_theme="$(basename "$(dirname "${pf_src}")")"
            pf_sz="$(basename "${pf_src}" .svg)"
            pf_dst="/usr/share/icons/${pf_theme}/places/${pf_sz}/folder.svg"
            [[ -e "${pf_dst}" ]] || continue
            cp -f "${pf_src}" "${pf_dst}"
            pf_n=$((pf_n + 1))
        done
        log "Per-Row-Icon-Tint aktiv (gepatchter Krusader), Stock-Ordner-Icons restauriert (${pf_n}), Bake uebersprungen"
    else
    # "KDE Default=true" (the Konfigurator's KDE default colours box) disables
    # every colour key below it without deleting them, so it means no colour.
    PF_KDEDEF="$(sed -n '/^\[Colors\]/,/^\[/{s/^KDE Default=//p}' "${CONFIG_HOME}/krusaderrc" 2>/dev/null | head -1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
    PF_RGB=""
    if [[ "${PF_KDEDEF}" != "true" ]]; then
        PF_RGB="$(sed -n '/^\[Colors\]/,/^\[/{s/^Directory Foreground=//p}' "${CONFIG_HOME}/krusaderrc" 2>/dev/null | head -1 | tr -d '[:space:]')"
        if [[ -z "${PF_RGB}" ]]; then
            PF_RGB="$(sed -n '/^\[Colors\]/,/^\[/{s/^Foreground=//p}' "${CONFIG_HOME}/krusaderrc" 2>/dev/null | head -1 | tr -d '[:space:]')"
        fi
    fi
    PF_HEX="$(rgb_to_hex "${PF_RGB}")"
    pf_n=0
    for pf_src in "${PF_STORE}"/*/*.svg; do
        [[ -e "${pf_src}" ]] || continue
        pf_theme="$(basename "$(dirname "${pf_src}")")"
        pf_sz="$(basename "${pf_src}" .svg)"
        pf_dst="/usr/share/icons/${pf_theme}/places/${pf_sz}/folder.svg"
        [[ -e "${pf_dst}" ]] || continue
        if [[ -n "${PF_HEX}" ]]; then
            bake_svg "${pf_src}" "${pf_dst}" "${PF_HEX}"
        else
            cp -f "${pf_src}" "${pf_dst}"
        fi
        pf_n=$((pf_n + 1))
    done
    if [[ -n "${PF_HEX}" ]]; then
        log "Dateilisten-Ordner-Icons auf Panel-Foreground ${PF_HEX} getoent (${pf_n} Dateien)"
    else
        log "Dateilisten-Ordner-Icons: keine eigene Panel-Farbe gesetzt, Stock-Icons restauriert (${pf_n})"
    fi
    fi # bake branch, unpatched apt Krusader only
fi

# File associations (#22): Kate is the default text handler, so a double-click
# opens it instead of the Open With dialog, and Open With offers it. Deployed
# to the XDG config home and the legacy data home on every start, so existing
# /config volumes get it too; the kbuildsycoca6 run below bakes it into KSycoca.
if [[ -f "${DEFAULTS}/mimeapps.list" ]]; then
    cp -af "${DEFAULTS}/mimeapps.list" "${CONFIG_HOME}/mimeapps.list"
    mkdir -p "${LOCAL_SHARE}/applications"
    cp -af "${DEFAULTS}/mimeapps.list" "${LOCAL_SHARE}/applications/mimeapps.list"
    log "mimeapps.list deployed (text/* default -> Kate)"
fi

chown -R abc:abc /config/.config /config/.local 2>/dev/null || true

# 3b) KService cache for Open With (#22). KOpenWithDialog is filled from
# KSycoca, a binary cache that KApplicationTrader queries, not from the
# .desktop files. A full Plasma session has kded6 build it at startup; under
# openbox kded6 starts late if at all, through D-Bus activation when some KIO
# call happens to trigger it, with no guarantee that this happens before the
# user's first Open With. Without the cache the dialog shows an empty
# application list and an empty command box, the same as reported for Dolphin
# under Hyprland outside a full KDE session.
# kbuildsycoca6 builds the cache synchronously in the calling process, is a
# cheap no-op when the .desktop directories did not change, and ships with
# libkf6service-bin. Running it on every start as abc, so the cache is owned by
# abc like everything Krusader and Kate create, closes the race.
mkdir -p /config/.cache
chown abc:abc /config/.cache
# KF6 krusader reads only ksycoca6_*; the KF5 ksycoca5_* files are leftovers.
rm -f /config/.cache/ksycoca5_* 2>/dev/null || true
# KIconLoader's pixmap cache survives image updates in /config and keeps serving
# the old icons, so a changed folder icon would not show. gtk-update-icon-cache
# does not touch it, and KIconLoader rebuilds it lazily.
rm -f /config/.cache/icon-cache.kcache 2>/dev/null || true
# s6-setuidgid changes only uid and gid, not the environment, so HOME and
# XDG_CACHE_HOME are set explicitly to put the cache in /config/.cache, where
# Krusader running as abc looks for it.
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    if env HOME=/config XDG_CACHE_HOME=/config/.cache s6-setuidgid abc kbuildsycoca6 --noincremental >/tmp/kbuildsycoca6.log 2>&1; then
        log "kbuildsycoca6: KService-Cache aufgebaut (Open With.../KApplicationTrader)"
    else
        log "WARNING: kbuildsycoca6 ist fehlgeschlagen, 'Oeffnen mit...' bleibt evtl. leer (siehe /tmp/kbuildsycoca6.log)"
    fi
else
    log "WARNING: kbuildsycoca6 nicht gefunden, 'Oeffnen mit...' zeigt eine leere Liste (Issue #22)"
fi

# 4) Diagnostics
log "=== Diagnose ==="
log "ColorScheme in kdeglobals: $(grep -E '^ColorScheme=' "${CONFIG_HOME}/kdeglobals" | head -n 1)"
log "theme=${KRUSADER_THEME:-dark} scheme=${THEME_SCHEME}; palette source ${THEME_COLORS} ($(ls -la "${THEME_COLORS}" 2>/dev/null | awk '{print $5}') bytes)"
log "kde-plattform-plugin: $(find /usr/lib -name 'libkdeplatformtheme.so' 2>/dev/null | head -n 1 || echo NOT-FOUND)"
log "breeze-style-plugin:  $(find /usr/lib -name 'breeze.so' -path '*styles*' 2>/dev/null | head -n 1 || echo NOT-FOUND)"
log "fc-list count:        $(fc-list 2>/dev/null | wc -l)"
log "kbuildsycoca6 cache:  $(find /config/.cache -iname '*sycoca*' 2>/dev/null | head -n 1 || echo NOT-FOUND)"

log "init-krusader done"
exit 0
