#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prints a READY banner to the container log once the WebUI is serving, so the
# user knows the first start has finished and the WebUI is usable.
FLAG="/run/krusader-ready.printed"

# /run is tmpfs (wiped on every container start) -> banner prints once per start.
if [[ -f "${FLAG}" ]]; then
    exec sleep infinity
fi

# Wait until the Selkies WebUI (nginx) accepts connections on its internal HTTP port
# (3000 is always served regardless of the user's HTTPS preference). Capped at
# ~5 min so we never hang forever.
ready=0
for _ in $(seq 1 150); do
    if (exec 3<>/dev/tcp/127.0.0.1/3000) 2>/dev/null; then
        exec 3>&- 3<&-
        ready=1
        break
    fi
    sleep 2
done

# Small settle so Krusader's window is actually drawn before we announce.
[[ "${ready}" -eq 1 ]] && sleep 4

# The brand banner is printed here so that it and the status line form the log's
# final block. The subtitle names the active theme.
case "${KRUSADER_THEME:-dark}" in
    light | Light | breeze | Breeze | BreezeLight) TH="Breeze Light" ;;
    *) TH="Dark Mode" ;;
esac
/usr/local/bin/print-banner.sh "Krusader for Unraid" "${TH} · Selkies · KDE" 2>/dev/null || true

# Plain ANSI SGR codes rather than tput, which needs a terminfo database a
# minimal container may lack. docker logs passes the bytes through, so an
# ANSI-aware viewer (a terminal, Unraid's log panel) shows the colour.
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

# print-banner.sh already left a blank line above this.
if [[ "${ready}" -eq 1 ]]; then
    echo -e "  ${GREEN}✓ KRUSADER IS READY${NC} - Open the WebUI via HTTPS on port ${CUSTOM_HTTPS_PORT:-3001}"
else
    echo -e "  ${RED}✗ KRUSADER DID NOT BECOME READY${NC} - The WebUI never answered within 5 minutes, check the log above"
fi
echo ""

touch "${FLAG}"
# Longrun: stay up so s6 does not restart us and re-print the banner.
exec sleep infinity
