#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Unraid passes blank CUSTOM_USER and PASSWORD fields as empty variables, and
# the base image's init-nginx enables basic auth whenever PASSWORD is set at
# all, even to "", which prompts for a login nobody can pass. Dropping the empty
# values before init-nginx runs keeps the template's "leave empty for no login";
# a real password still enables basic auth.
if [ -z "${PASSWORD}" ]; then
  rm -f /run/s6/container_environment/PASSWORD
fi
if [ -z "${CUSTOM_USER}" ]; then
  rm -f /run/s6/container_environment/CUSTOM_USER
fi
