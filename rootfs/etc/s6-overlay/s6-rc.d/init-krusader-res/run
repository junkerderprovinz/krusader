#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Settles the screen size before the X server starts. The template offers it
# twice, MAX_RES as a dropdown of presets and MAX_RES_CUSTOM as a free field,
# because Unraid turns any variable whose Default contains a "|" into a plain
# <select> with no way to type a value. krusader-resolution.sh picks between
# them and this oneshot writes the result into the s6 container environment.
#
# svc-xorg reads MAX_RES when it builds the Xvfb command line, so this has to
# run first. rootfs/etc/s6-overlay/s6-rc.d/svc-xorg/dependencies.d/
# init-krusader-res makes s6-rc enforce that; without it the two could start in
# either order and the custom value would apply on some boots only. That one
# dependency is enough: in the built image svc-xorg/run is the only file under
# /etc/s6-overlay/s6-rc.d/ that mentions MAX_RES.
set -e

resolution="$(/usr/local/bin/krusader-resolution.sh)"

mkdir -p /run/s6/container_environment

if [[ -n "${resolution}" ]]; then
    printf "%s" "${resolution}" > /run/s6/container_environment/MAX_RES
    echo "[init-krusader-res] screen size for this boot: ${resolution}"
else
    # The docker environment is imported into this directory, so a MAX_RES the
    # script rejected is sitting here already and would reach Xvfb verbatim:
    # X would fail to start and the container would come up with no desktop.
    # Removing the file lets the base image apply its own default.
    # init-nologin deletes an empty PASSWORD from the same directory for the
    # same reason.
    rm -f /run/s6/container_environment/MAX_RES
    echo "[init-krusader-res] no usable screen size given, leaving the base image default in place"
fi

exit 0
