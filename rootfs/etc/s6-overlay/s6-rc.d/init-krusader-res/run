#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# -----------------------------------------------------------------------------
# init-krusader-res — settle the screen size BEFORE the X server starts
# -----------------------------------------------------------------------------
# The template offers the screen size twice: MAX_RES as a dropdown of presets
# and MAX_RES_CUSTOM as a free field, because Unraid turns any variable whose
# Default contains a "|" into a plain <select> with no way to type a value.
# krusader-resolution.sh picks between them; this service writes the result
# into the s6 container environment so svc-xorg sees it.
#
# ORDERING IS THE WHOLE POINT: svc-xorg reads MAX_RES when it builds the Xvfb
# command line, so this must have run first. rootfs/etc/s6-overlay/s6-rc.d/
# svc-xorg/dependencies.d/init-krusader-res makes s6-rc enforce that; without
# that file the two would be free to start in either order and the custom
# value would be applied on some boots and not others.
#
# That single dependency is enough: checked in the built image, svc-xorg/run is
# the ONLY file under /etc/s6-overlay/s6-rc.d/ that mentions MAX_RES, so no
# other service writes the value we would have to run after.
# -----------------------------------------------------------------------------
set -e

resolution="$(/usr/local/bin/krusader-resolution.sh)"

mkdir -p /run/s6/container_environment

if [[ -n "${resolution}" ]]; then
    printf "%s" "${resolution}" > /run/s6/container_environment/MAX_RES
    echo "[init-krusader-res] screen size for this boot: ${resolution}"
else
    # The docker environment is imported into this directory, so a MAX_RES the
    # script rejected is sitting here already and would reach Xvfb verbatim:
    # X would fail to start and the container would come up with no desktop.
    # Removing the file is what makes the fallback real — the base image then
    # applies its own default. init-nologin deletes an empty PASSWORD from the
    # same directory for the same reason.
    rm -f /run/s6/container_environment/MAX_RES
    echo "[init-krusader-res] no usable screen size given, leaving the base image default in place"
fi

exit 0
