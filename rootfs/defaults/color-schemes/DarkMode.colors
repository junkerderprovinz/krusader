# Dark Mode: monochrome IBM Carbon greyscale (base #161616) with no colour
# accent. Selection and focus are a lighter grey (#525252); the only other tones
# are the functional error and warning colours.
#
# KDE matches the scheme by this file's basename, so the [General] ColorScheme
# value and every reference stay "DarkMode", without a space.

[ColorEffects:Disabled]
Color=31,31,31
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=111,111,111
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

