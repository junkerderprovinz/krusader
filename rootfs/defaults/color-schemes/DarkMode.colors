[Colors:Selection]
# Selection and highlight are grey (#525252) rather than a colour accent. This is
# the Qt Highlight role, which the user cannot change from inside Krusader, so
# it stays in the Dark Mode greys. It colours the app chrome: the active panel's
# tab indicator, the Konfigurator page navigation, checkbox marks and menu
# highlights. The green goes only where the user can change it (Settings >
# Colors): the file list selection and the active status bar, both set in
# krusaderrc [Colors]. ForegroundNormal stays near-white so selected text reads
# on the grey bar.
BackgroundAlternate=82,82,82
BackgroundNormal=82,82,82
DecorationFocus=82,82,82
DecorationHover=82,82,82
ForegroundActive=244,244,244
ForegroundInactive=111,111,111
ForegroundLink=141,141,141
ForegroundNegative=250,77,86
ForegroundNeutral=241,194,27
ForegroundNormal=244,244,244
ForegroundPositive=141,141,141
ForegroundVisited=141,141,141

