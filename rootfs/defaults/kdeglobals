# KDE defaults for the Krusader image. init-krusader deploys this file on every
# start to /config/.config/kdeglobals and /config/.config/kdedefaults/kdeglobals.
#
# libkdeplatformtheme.so (from plasma-integration) reads it directly and takes
# the ColorScheme name "DarkMode" from it, which it resolves to
# /usr/share/color-schemes/DarkMode.colors.

[General]
ColorScheme=DarkMode
Name=Dark Mode
shadeSortColumn=true
AccentColor=255,255,255
accentColorFromWallpaper=false
widgetStyle=Breeze
fixed=Noto Mono,10,-1,5,50,0,0,0,0,0
font=Noto Sans,10,-1,5,50,0,0,0,0,0
menuFont=Noto Sans,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Noto Sans,8,-1,5,50,0,0,0,0,0
toolBarFont=Noto Sans,10,-1,5,50,0,0,0,0,0

[KDE]
ColorScheme=DarkMode
LookAndFeelPackage=org.kde.breezedark.desktop
SingleClick=false
contrast=4
widgetStyle=Breeze

[Icons]
Theme=breeze-dark
