# Krusader defaults, copied to /config/.config/krusaderrc on the first start
# when no file exists there; an existing config is left alone.

[General]
Editor=kate
View Font=Noto Sans,10,-1,5,50,0,0,0,0,0
Filelist Font=Noto Sans,10,-1,5,50,0,0,0,0,0
Show hidden files=true
Mark Dirs=false

[Look&Feel]
Filelist Icon Size=22
Single Click Selects=false
Show Hidden Files=true
Mark Dirs=false
Numeric permissions=false
Human Readable Size=true

[Archives]
Do Test Archive=true
Allow Move Into Archive=true
Use Krarc for Archives=true
Test Archives Before Use=true
fallback_extractor=true

[Startup]
Show splashscreen=false
Start To Tray=false
# Save last position, size and panel settings
Remember Position=true
# Save component settings on exit. Without it Krusader forgets View > Show
# Statusbar, Show Toolbar and the like after a restart.
User Save Settings=true
Show statusbar=true
Show Cmd Line=true
Show Function Keys=true
Show Terminal Emulator=false

[Private]
RememberPos=true

[Colors]
# Krusader's own file panel colours, editable under Settings > Configure
# Krusader > Colors. Only the green accents are preset; every key left unset
# inherits the dark KDE colour scheme (Qt palette). The app chrome (active tab
# line, Konfigurator page navigation, checkbox marks, menus) is not a Krusader
# colour and stays grey through the scheme's [Colors:Selection].
#
# Checked against Krusader's KF6 source (app/Panel/krcolorcache.cpp):
#   * the flag key is "KDE Default" with a space; "KDEDefault" is silently
#     ignored, which leaves the flag at its default of true and disables every
#     key below.
#   * colour values are decimal R,G,B; a #hex string has no commas and is
#     discarded.
#   * the scheme itself comes from kdeglobals and KDE_COLOR_SCHEME_PATH (set by
#     init-krusader), so no ColorScheme= line is needed here.
KDE Default=false
# File list selection, Krusader's "Marked" item: Carbon green #198038 with
# near-white text, shown in the dialog as "Selected background / foreground".
Marked Background=25,128,56
Marked Foreground=244,244,244
# Current row: a subtle grey that stays visible on the dark base and differs
# from the green selection ("Current background / foreground").
Current Background=57,57,57
Current Foreground=244,244,244
# The active panel's status line in the same green. ListPanelFrame reads it
# regardless of "KDE Default", and for the active panel only.
Statusbar Background Active=25,128,56
Statusbar Foreground Active=244,244,244
