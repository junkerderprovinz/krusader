#!/bin/sh
# Krusader session autostart for linuxserver/baseimage-selkies.
#
# openbox runs this with /bin/sh (dash) whatever the shebang says, so a bashism
# such as [[ ]] fails silently ("[[: not found", the block is skipped) while the
# rest carries on. Keep it POSIX.
#
# init-selkies-config copies it to /config/.config/openbox/autostart on the
# first start and init-krusader replaces it on every start after that. The
# theme variables are set primarily through /run/s6/container_environment; they
# are exported again here for launch paths that bypass with-contenv.

# The KDE platform plugin (libkdeplatformtheme.so from plasma-integration) makes
# Krusader and Kate read kdeglobals ([Icons] Theme, [Colors:*]) natively. It is
# set unconditionally: the session inherits the image ENV
# QT_QPA_PLATFORMTHEME=qt5ct because the s6 env does not reach it, so a ":-kde"
# fallback would keep qt5ct and kdeglobals, with its icon theme switch, would be
# ignored.
export QT_QPA_PLATFORMTHEME="kde"
export XDG_CURRENT_DESKTOP="KDE"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-KDE}"
export DESKTOP_SESSION="${DESKTOP_SESSION:-plasma}"

export QT_STYLE_OVERRIDE="${QT_STYLE_OVERRIDE:-Breeze}"
export QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR:-1}"
export KDE_COLOR_SCHEME_PATH="${KDE_COLOR_SCHEME_PATH:-/usr/share/color-schemes/DarkMode.colors}"

if [ ! -f "$KDE_COLOR_SCHEME_PATH" ] && [ -f "$HOME/.local/share/color-schemes/DarkMode.colors" ]; then
    export KDE_COLOR_SCHEME_PATH="$HOME/.local/share/color-schemes/DarkMode.colors"
fi

export GTK_THEME="${GTK_THEME:-Breeze-Dark}"
export XCURSOR_THEME="${XCURSOR_THEME:-breeze_cursors}"

# The Selkies desktop session does not pick up the s6 container_environment
# values (the running app had LANG=C.UTF-8 and LANGUAGE=en_US despite a correct
# s6 env), so the snippet from krusader-language.sh is sourced here, right
# before the session starts, which works for every PUID. With
# KRUSADER_LANG=system there is no snippet and the fallbacks apply.
if [ -f /config/.profile.d/krusader-lang.sh ]; then
    # shellcheck disable=SC1091
    . /config/.profile.d/krusader-lang.sh
    echo "[krusader-autostart] language snippet sourced: LANG=$LANG LANGUAGE=$LANGUAGE" >&2
fi
export LANG="${LANG:-en_US.UTF-8}"
export LANGUAGE="${LANGUAGE:-en_US:en}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# Under PUID=0 the session runs as literal root (LSIO cannot remap abc onto uid
# 0), whose default $HOME/.{config,cache,local/share} differ from abc's /config
# tree, so config, the KSycoca cache and file type associations would land
# where the running Krusader does not read them (#22). Pinning the XDG dirs to
# /config makes root and non-root behave the same, and /usr/share/applications
# (Kate's .desktop) stays on the scan path so Open With and the mimeapps.list
# default resolve.
export XDG_CONFIG_HOME="/config/.config"
export XDG_DATA_HOME="/config/.local/share"
export XDG_CACHE_HOME="/config/.cache"
case ":${XDG_DATA_DIRS:-}:" in
    *":/usr/share:"*) : ;;
    *) export XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}/usr/local/share:/usr/share" ;;
esac
echo "[krusader-autostart] XDG pinned: CONFIG=$XDG_CONFIG_HOME CACHE=$XDG_CACHE_HOME DATA_DIRS=$XDG_DATA_DIRS" >&2

echo "[krusader-autostart] QT_QPA_PLATFORMTHEME=$QT_QPA_PLATFORMTHEME" >&2
echo "[krusader-autostart] XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP" >&2
echo "[krusader-autostart] QT_STYLE_OVERRIDE=$QT_STYLE_OVERRIDE" >&2
echo "[krusader-autostart] KDE_COLOR_SCHEME_PATH=$KDE_COLOR_SCHEME_PATH" >&2
echo "[krusader-autostart] GTK_THEME=$GTK_THEME" >&2
echo "[krusader-autostart] LANG=$LANG" >&2

# The Selkies base starts Xvfb with no keymap and leaves the X11 keymap to the
# deployment. Selkies' keystroke retype paste path (input.js's
# _handleMobileInput, used whenever the byte-exact clipboard channel is
# unavailable, notably on Firefox; see TROUBLESHOOTING.md Bug #5) injects
# Shift_L plus the lowercase keysym, and without a keymap Shift_L never binds,
# so every capital falls to keymap level 0. A full keymap binds Shift_L
# as a real modifier and gives each letter an uppercase level 1. That closes one
# failure mode of the retype path, an unbound Shift, not the flaws in the
# path's own design (Bug #5), so test before assuming a paste bug is fixed.
# KEYBOARD_LAYOUT (default us) lets non-US users pick their layout. The real
# exit status and stderr are logged so a failed bind shows up in `docker logs`.
if setxkbmap_out=$(setxkbmap -display "${DISPLAY:-:1}" -layout "${KEYBOARD_LAYOUT:-us}" 2>&1); then
    echo "[krusader-autostart] keymap: layout=${KEYBOARD_LAYOUT:-us} bound OK" >&2
else
    echo "[krusader-autostart] keymap: setxkbmap FAILED (layout=${KEYBOARD_LAYOUT:-us}): ${setxkbmap_out}" >&2
fi

# dbus-launch provides the bus for the KIO workers (krarc, file, smb, ...).
# startwm.sh already wraps openbox in dbus-launch, so this inner bus is nested;
# it stays because it works, although a box test showed duplicate kded and KIO
# effects. krusader-session starts ksmserver before krusader in the same D-Bus
# context, which window state persistence (bug #1) and Kate's close events
# (bug #2) depend on.
exec dbus-launch --exit-with-session krusader-session
